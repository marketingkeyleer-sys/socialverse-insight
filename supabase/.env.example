# Server-only: set these as Supabase Edge Function secrets, never VITE_*.
APP_URL=http://localhost:5173
OAUTH_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
OAUTH_ENCRYPTION_KEY=
META_CLIENT_ID=
META_CLIENT_SECRET=
# Required only for Facebook Login for Business; belongs to META_CLIENT_ID.
META_LOGIN_CONFIG_ID=
# Start with connection scopes; add only permissions approved for your app.
FACEBOOK_OAUTH_SCOPES=public_profile,pages_show_list,pages_read_engagement
INSTAGRAM_OAUTH_SCOPES=public_profile,pages_show_list,pages_read_engagement,instagram_basic
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_OAUTH_SCOPES=openid profile email
LINKEDIN_ORG_CLIENT_ID=
LINKEDIN_ORG_CLIENT_SECRET=
LINKEDIN_PAGE_OAUTH_SCOPES=r_organization_social,rw_organization_admin,w_organization_social
LINKEDIN_API_VERSION=202609
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
CRON_SECRET=
# Optional existing AI feature.
OPENAI_API_KEY=
# Existing WhatsApp integrations; see whatsapp-bridge/README.md.
WHATSAPP_BRIDGE_URL=
WHATSAPP_BRIDGE_KEY=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
