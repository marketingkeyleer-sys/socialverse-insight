{
  "name": "socialverse",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "test": "node --loader ./tests/ts-loader.mjs --test tests/*.test.mjs",
    "dev": "vite",
    "build": "tsc -b && vite build",
    "build:dev": "vite build --mode development",
    "lint": "oxlint",
    "preview": "vite preview",
    "setup:bridge": "node scripts/setup-bridge.cjs",
    "bridge": "npm start --prefix whatsapp-bridge",
    "dev:all": "npm run setup:bridge && concurrently -k -n app,bridge -c cyan,green \"npm:dev\" \"npm:bridge\"",
    "dev:all:public": "npm run setup:bridge && concurrently -k -n app,bridge,tunnel -c cyan,green,yellow \"npm:dev\" \"npm:bridge\" \"npx --yes cloudflared tunnel --url http://localhost:3000\""
  },
  "dependencies": {
    "@fontsource-variable/geist": "^5.3.0",
    "@supabase/supabase-js": "^2.112.4",
    "@tanstack/react-query": "^5.102.5",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "lucide-react": "^1.34.0",
    "next-themes": "^0.4.6",
    "radix-ui": "^1.6.7",
    "react": "^19.2.8",
    "react-day-picker": "^10.0.1",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.2",
    "recharts": "^3.10.1",
    "shadcn": "^4.19.0",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.1.0",
    "concurrently": "^10.0.5",
    "oxlint": "^1.79.0",
    "supabase": "^2.115.0",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.2",
    "vite": "^8.2.2"
  }
}
