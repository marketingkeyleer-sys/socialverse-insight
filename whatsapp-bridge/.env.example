# Required. A long random string (24+ chars). SocialVerse sends it as the
# Bearer token on every request, and the bridge uses it to sign callbacks.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
BRIDGE_API_KEY=

# Required for delivery results and STOP replies. Your SocialVerse webhook:
# https://<project-ref>.supabase.co/functions/v1/whatsapp-webhook
# The bridge only ever calls back to this host.
CALLBACK_URL=

# How many WhatsApp numbers this one server links at once. Each is its own
# Chromium (roughly 300-500 MB of RAM), so size the server to match.
MAX_SESSIONS=10

# Linked sessions and unfinished jobs live here. Use a persistent volume in
# production (Railway: /data) or everyone has to re-scan after each deploy.
DATA_DIR=./data

PORT=3000
# Local default is 127.0.0.1; production (NODE_ENV=production) binds 0.0.0.0.
# HOST=

# Optional: use an installed Chrome/Chromium instead of Puppeteer's download.
# PUPPETEER_EXECUTABLE_PATH=
# Only inside a container.
# CHROME_NO_SANDBOX=true

# Local testing only: allow an http://localhost callback URL.
# ALLOW_INSECURE_CALLBACK=true
